VITE_APP_TITLE="ConnectSphere"
VITE_SENTRY_DSN="https://123456789.ingest.us.sentry.io/123456789"
VITE_SENTRY_ORG="your-sentry-org"
VITE_SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Environment tag for the server Sentry SDK. Defaults to "development" when unset.
# SENTRY_ENVIRONMENT="development"

SERVER_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-32-character-secret"

# Bearer token for /api/smoke. Deployed environments require this release gate.
# SMOKE_TOKEN="replace-with-a-random-32-byte-hex-string"

# Bearer token for the notification email worker at /api/cron/notifications (PTR-55). Cloud
# Scheduler sends it in deployed environments. Locally, POST to the route with this token to drain
# the queue. E2E uses a default token when this variable is unset.
# CRON_TOKEN="replace-with-a-random-32-byte-hex-string"

RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@example.com"
# Optional SMTP relay for local and E2E mail capture, such as Mailpit at smtp://localhost:1025.
# When set, send email over SMTP instead of Resend. Leave this unset in production.
# SMTP_URL="smtp://localhost:1025"

# Redis connection for src/lib/redis.server.ts (Bun's native Redis client). Currently unused.
# REDIS_URL="redis://localhost:6379"

# Optional object storage for draft supporting documents. Leave STORAGE_BUCKET unset to run
# without attachments: the draft page reports attaching as unavailable and all else works.
# STORAGE_BUCKET="connectsphere-attachments-staging"
# S3-compatible endpoint for local MinIO. Leave unset for the provider default.
# STORAGE_ENDPOINT="http://localhost:9000"
# STORAGE_REGION="asia-southeast1"
# GCS HMAC pair (created with `gcloud storage hmac create`, stored as secrets), or MinIO
# credentials locally.
# STORAGE_ACCESS_KEY_ID="replace-with-the-hmac-access-id"
# STORAGE_SECRET_ACCESS_KEY="replace-with-the-hmac-secret"
