VITE_APP_TITLE="ConnectSphere"
VITE_SENTRY_DSN="https://123456789.ingest.us.sentry.io/123456789"
VITE_SENTRY_ORG="your-sentry-org"
VITE_SENTRY_PROJECT="your-sentry-project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

SERVER_URL="http://localhost:3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-32-character-secret"

# Release-gate bearer token for /api/smoke (required in deployed environments)
# SMOKE_TOKEN="replace-with-a-random-32-byte-hex-string"

RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@example.com"

# S3-compatible object storage
# Works with MinIO, S3, R2, or Supabase Storage
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="app"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="password"

# Redis connection for src/lib/redis.server.ts (Bun native Redis client); currently unused.
# REDIS_URL="redis://localhost:6379"
