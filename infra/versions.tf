terraform {
  required_version = ">= 1.5"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 7.0"
    }
    # Pinned to v4; bump only once the v5 upgrade is reviewed.
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 4.0"
    }
  }

  backend "gcs" {
    bucket = "connectsphere-is212-tfstate"
    prefix = "terraform/state"
  }
}
