{
  "name": "tanstack-start-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "clean": "bunx rimraf .output .vite node_modules .tanstack src/routeTree.gen.ts coverage test-results playwright-report",
    "dev": "bun --bun --import ./instrument.server.mjs vite dev --port 3000",
    "build": "bun --bun vite build",
    "build:docker": "docker build -t tanstack-start-template .",
    "preview": "vite preview",
    "start": "bun --import ./instrument.server.mjs .output/server/index.mjs",
    "type:check": "tsc --noEmit",
    "lint:check": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "auth:generate": "bunx auth@latest generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "bun scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "codegen": "playwright codegen",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/passkey": "^1.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@logtape/logtape": "^2.3.3",
    "@logtape/sentry": "^2.3.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/tanstackstart-react": "^10.73.0",
    "@shadcn/react": "^0.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.41.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pg": "^8.23.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/instrumentation": "0.214.0",
    "esbuild": "^0.25.0"
  },
  "packageManager": "bun@1.3.14"
}
